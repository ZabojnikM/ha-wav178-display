{
  "name": "WAV178 FVE Display",
  "version": "0.1.0",
  "slug": "wav178_display",
  "description": "Python server a FVE dashboard pro Waveshare 4,2″ Cloud Module s originálním firmwarem",
  "arch": ["aarch64", "amd64"],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "homeassistant_api": true,
  "ingress": true,
  "ingress_port": 8099,
  "panel_title": "FVE displej",
  "panel_icon": "mdi:solar-power",
  "ports": {"6868/tcp": 6868},
  "ports_description": {"6868/tcp": "Příchozí spojení displeje Waveshare (domácí LAN)"},
  "options": {
    "display_interval": 60,
    "poll_interval": 60,
    "stale_after_seconds": 180,
    "device_ip": "",
    "display_password": "",
    "battery_positive": "unknown",
    "frame_number": "zero",
    "entity_soc": "",
    "entity_pv": "",
    "entity_battery": "",
    "entity_grid": "",
    "entity_tuv_top": "",
    "entity_tuv_bottom": "",
    "entity_tuv_power": "",
    "entity_wallbox": ""
  },
  "schema": {
    "display_interval": "int(30,3600)",
    "poll_interval": "int(10,3600)",
    "stale_after_seconds": "int(30,86400)",
    "device_ip": "str",
    "display_password": "password",
    "battery_positive": "list(unknown|charging|discharging)",
    "frame_number": "list(zero|sector)",
    "entity_soc": "str",
    "entity_pv": "str",
    "entity_battery": "str",
    "entity_grid": "str",
    "entity_tuv_top": "str",
    "entity_tuv_bottom": "str",
    "entity_tuv_power": "str",
    "entity_wallbox": "str"
  }
}
